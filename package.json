{
  "name": "fragment",
  "version": "0.0.5",
  "private": true,
  "description": "Fragment by Auto Scale Agency - a local-first visual reference vault.",
  "license": "MIT",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @fragment/desktop tauri dev",
    "build:desktop": "cargo build --release -p fragment-host --bin fragment-host && pnpm --filter @fragment/desktop tauri build",
    "build:desktop:frontend": "pnpm --filter @fragment/desktop build",
    "dev:extension": "pnpm --filter @fragment/extension dev",
    "build:extension": "pnpm --filter @fragment/extension build",
    "smoke:extension-capture": "node scripts/extension-capture-smoke.mjs",
    "smoke:native-host": "node scripts/native-host-smoke.mjs",
    "benchmark:pinterest-quality": "node scripts/pinterest-quality-benchmark.mjs",
    "benchmark:vault:fixtures": "node scripts/generate-vault-fixtures.mjs",
    "benchmark:vault:fixtures:verify": "node scripts/verify-vault-fixtures.mjs",
    "benchmark:vault:metadata": "node scripts/benchmark-vault-metadata.mjs",
    "release:local": "node scripts/build-local-release.mjs",
    "version:set": "node scripts/set-version.mjs",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/chrome": "^0.0.268",
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "eslint": "^9.26.0",
    "eslint-config-prettier": "^10.1.2",
    "playwright": "^1.61.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.3"
  }
}
